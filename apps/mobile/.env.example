# Copy to apps/mobile/.env and fill in from Firebase console > Project settings > Your apps > Web app.
# These Firebase web keys are not secrets (security comes from Firestore rules), but keep .env out of git anyway.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=gully-adda.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=gully-adda
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=gully-adda.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Cloud Functions region (must match functions/src/config.ts)
EXPO_PUBLIC_FUNCTIONS_REGION=asia-south1
# Set to "true" to talk to local emulators (npm run emulators at repo root)
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2
# Voice chat for online Mafia (needs a development/production build, not Expo Go)
EXPO_PUBLIC_VOICE_ENABLED=false
# LiveKit server URL, e.g. wss://your-project.livekit.cloud (API key/secret live in Functions secrets, never here)
EXPO_PUBLIC_LIVEKIT_URL=
# Public URLs shown in Settings
EXPO_PUBLIC_PRIVACY_URL=https://valuetools101.github.io/Gully-Adda/privacy.html
EXPO_PUBLIC_DELETE_URL=https://valuetools101.github.io/Gully-Adda/delete-account.html
EXPO_PUBLIC_TERMS_URL=https://valuetools101.github.io/Gully-Adda/house-rules.html
# EAS
EAS_PROJECT_ID=
