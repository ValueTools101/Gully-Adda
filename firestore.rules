rules_version = '2';

// Gully Adda: clients can only READ. Every write goes through Cloud Functions
// (Admin SDK bypasses these rules). Tested in functions/test/emulator/rules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(code) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.memberUids;
    }

    match /rooms/{code} {
      // Lobby/room info (seats, game, settings, status). No secrets live here.
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      // Full authoritative game state: server only.
      match /private/{doc} {
        allow read, write: if false;
      }

      // Each player's redacted view: only that player, and only while a member.
      match /views/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(code);
        allow write: if false;
      }

      // Chat: only the readers chosen by the server (phase rules + blocks).
      match /chat/{msg} {
        allow read: if signedIn() && request.auth.uid in resource.data.readers;
        allow write: if false;
      }
    }

    // Server-only collections.
    match /users/{uid} {
      allow read, write: if false;
    }
    match /reports/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
