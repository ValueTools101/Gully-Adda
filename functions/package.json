{
  "name": "functions",
  "private": true,
  "description": "Gully Adda Cloud Functions: the only writer of online game state. Bundles @gully/engine with esbuild.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src test",
    "test": "vitest run test/unit",
    "test:emulator": "vitest run test/emulator --no-file-parallelism"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.37.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "livekit-server-sdk": "^2.20.1"
  }
}
